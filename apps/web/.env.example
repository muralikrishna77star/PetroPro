# Copy to .env.local for local dev, or set as Vercel project env vars for production
# (vercel env add NAME production). Both are baked in at build time, so changing
# either on Vercel requires a redeploy.

NEXT_PUBLIC_API_URL=http://localhost:4000

# Only set to "true" on deployments where the API also has GOOGLE_CLIENT_ID/
# GOOGLE_CLIENT_SECRET configured (apps/api/.env.example) — otherwise the
# "Sign in with Google" button appears but the API will 501.
NEXT_PUBLIC_GOOGLE_SSO_ENABLED=false

# Only relevant to the desktop kiosk launcher (scripts/desktop/start.mjs, not a normal
# browser/PWA session). Must match that script's own (non-NEXT_PUBLIC_) DESKTOP_CONTROL_PORT
# env var if you override it there — this is the client-side copy DesktopTitleBar's Close
# button uses to reach the same local control server.
NEXT_PUBLIC_DESKTOP_CONTROL_PORT=4098
