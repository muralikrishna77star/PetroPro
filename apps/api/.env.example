# Copy to .env for local dev, or set these as Fly.io secrets/env for production
# (fly secrets set NAME=value -a petropro-api). None are required to run the API —
# every one of them has a working default for local dev (see src/config.ts).

PORT=4000
HOST=0.0.0.0
JWT_SECRET=petropro-dev-secret-change-me
DB_PATH=./data/petropro.db

# Public origin of this API itself. Only matters when GOOGLE_OAUTH_REDIRECT_URI isn't
# set explicitly (see below) — used to build the default Google callback URL. In
# production, set GOOGLE_OAUTH_REDIRECT_URI directly instead and skip this.
API_PUBLIC_URL=http://localhost:4000

# Where the browser lands after Google sign-in (apps/web's own origin, not the API's).
WEB_APP_URL=http://localhost:3000

# --- Staff sessions (optional, these are the defaults) ---
# Access tokens last minutes. The refresh cookie renews them until the session has been idle this
# long or reaches its absolute limit, after which the user signs in again.
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# --- Google Sign-In (optional) ---
# Leave both blank to disable the feature entirely (API returns 501, web hides the
# button). Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application") with an authorized redirect URI matching
# GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the Google OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Technology dashboard provider checks (optional, super admins only) ---
# Read-only. Each one lets the dashboard confirm that provider's plan name, and nothing else:
# subscription and billing status stay manually recorded. Never sent to the browser. Leave
# blank to show "Not configured". In production, set these as Fly.io secrets.
# Vercel: a token from https://vercel.com/account/tokens, and the team ID from team settings.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# GitHub: a token belonging to the repository owner's account (its plan is the one reported).
GITHUB_TOKEN=
