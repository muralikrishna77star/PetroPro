function onlyformurali
DEFINE WINDOW muraliwin FROM 15,20 to 23,60 double
ACTIVATE WINDOW muraliwin
question=space(10)
cmd=space(25)
@ 0,3 say "Welcome Murali Krishna!    :" color W+/G
@ 1,3 say "Please Tell me the Secret Word ê:" color W+/G
@ 5,14 get question color R/n, RGB(150,150,150,150,150,150)
read
if question="KissMeDear"
@ 0,0 say "Welcome Murali Krishna!       " color W+/G
@ 1,0 say "Tell Me Your Command To Execute Sir! " color W+/G
@ 0,37 say "" color GR+*/R
@ 1,37 say "ê" color GR+*/R

wish='Y'
do while wish='Y'
restore macros
@ 3,6 get cmd
read
on error do cmderr
cmd=alltrim(cmd)
 DEFINE WINDOW output FROM 5,0 TO 24,79 PANEL TITLE 'RESULT FOR YOUR REQUEST' ;
 CLOSE FLOAT GROW SHADOW ZOOM COLOR SCHEME 8
 ACTIVATE WINDOW OUTPUT
&cmd
DEACTIVATE WINDOW OUTPUT
cmd=space(25)
@ 5,5 say "Can I Serve You Once Again :" get wish
read
@ 5,5 say "                   "     
enddo
clear macros
deactivate window muraliwin
else
clear 
@ 3,10 say "Sorry! This is a No Entry Zone" color GR+*
@ 4,10 say "  For Un-Authorized Users" color GR+*
for cnt=1 to 1000
endfor
deactivate window muraliwin
endif


procedure cmderr
Wait Window "I am Sorry! I Can't Understood U'r Command"
on error
return


procedure retprompt
close all
CANCEL
return
