CLOSE ALL
workpath=getkey("WORKINGPATH")
prnport=getkey("PRNPORT")
set default to &workpath
set printer to &prnport
clear macros
*set  on
set help off
clear all
release all
release all
PrnTstMode=Boolean(getKey("PrintTestMode"))
PrnSplChar=Boolean(getKey("PrintSpecialCharacters"))
BillEntry=Boolean(getKey("BillEntry"))
Kerosene=Boolean(getKey("Kerosene"))
FleetCardEntry=Boolean(getKey("FleetCardEntry"))

Kno=6
Ver=getKey("VERSION")
Header1=space(37)
Header2=space(37)
Header3=space(37)
Header4=space(37)
Header5=space(37)

EXPIRY=""
validdays=0


DO RDENCHDR



on Escape Wait window "You can't Exit now"
ON KEY LABEL F2 		
ON KEY LABEL ESC

on key label f8 do calc
on key label f11 do retprompt
on key label f12 man=onlyformurali()
set color to W+
set date to british
set century on
set escape off
set procedure to
clear
set talk off
set echo off
set date british
set century on
set sysmenu off


IF Len(EXPIRY)<>0
	stdate=ctod(substr(expiry,1,10))
	validdays=val(substr(expiry,11,len(expiry)-10))
	*wait window alltrim(str(validdays))
	*wait window alltrim(str(count))
	Trialbal=validdays-(date()-stdate)
	IF validdays<Trialbal
		Wait window "You Trial Period has ended. Please Contact Software Vendor"
		quit
	ENDIF
ENDIF


cont='c'
do decor
member=secure()
*do dam
do while .T.
on error
do top

*wait window expiry
if len(expiry)<>0
	*wait window alltrim(str(validdays))
	@ 1, 58 say "Trial:"+ alltrim(str(TrialBal))
endif 

