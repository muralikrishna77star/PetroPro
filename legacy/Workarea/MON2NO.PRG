function mon2no
parameter monname
do case
case upper(alltrim(monname))="APRIL"
return 4
case upper(alltrim(monname))="MAY"
return 5
case upper(alltrim(monname))="JUNE"
return 6
case upper(alltrim(monname))="JULY"
return 7
case upper(alltrim(monname))="AUGUST"
return 8
case upper(alltrim(monname))="SEPTEMBER"
return 9
case upper(alltrim(monname))="OCTOBER"
return 10
case upper(alltrim(monname))="NOVEMBER"
return 11
case upper(alltrim(monname))="DECEMBER"
return 12
case upper(alltrim(monname))="JANUARY"
return 1
case upper(alltrim(monname))="FEBRUARY"
return 2
case upper(alltrim(monname))="MARCH"
return 3
endcase
