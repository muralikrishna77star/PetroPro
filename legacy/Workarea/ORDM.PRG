Function ORDM
PARAMETER MONNAME
PICMON=UPPER(SUBSTR(MONNAME,1,3))
DO CASE 
	CASE PICMON="APR"
		RETURN 1
	CASE PICMON="MAY"
		RETURN 2
	CASE PICMON="JUN"
		RETURN 3
	CASE PICMON="JUL"
		RETURN 4
	CASE PICMON="AUG"
		RETURN 5
	CASE PICMON="SEP"
		RETURN 6
	CASE PICMON="OCT"
		RETURN 7
	CASE PICMON="NOV"
		RETURN 8
	CASE PICMON="DEC"
		RETURN 9
	CASE PICMON="JAN"
		RETURN 10
	CASE PICMON="FEB"
		RETURN 11
	CASE PICMON="MAR"
		RETURN 12
ENDCASE		
	